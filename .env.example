# GitHub Configuration
# PAT (classic) со scope repo + project
GITHUB_TOKEN=ghp_your_personal_access_token_here
# репозиторий, в котором создаются Issues; заказы и черновики откликов лучше держать в приватном
GITHUB_REPO=your-login/your-repo
# номер проекта (Projects v2) из его URL: github.com/users/<login>/projects/<номер>
GITHUB_PROJECT_ID=1
# владелец проекта (user/org); пусто — владелец GITHUB_REPO
GITHUB_PROJECT_OWNER=
# поле проекта и колонка для новых Issues
GITHUB_PROJECT_STATUS_FIELD=Status
GITHUB_PROJECT_STATUS_OPTION=Backlog
# метка всех Issues парсера (по ней ищутся уже созданные)
GITHUB_ISSUE_LABEL=freelance

# Anthropic API (получить через `claude setup-token`)
ANTHROPIC_API_KEY=sk-ant-v1-your_key_here
ANALYZER_MODEL=claude-haiku-4-5
ANALYZER_CONCURRENCY=3
# стек исполнителя — подставляется в промпты анализатора и префильтра
DEVELOPER_STACK=Go, TypeScript, JavaScript, Python (бэкенд, API, боты, парсеры, автоматизация, веб-фронтенд)

# Префильтр через OpenRouter (пусто — отключён)
OPENROUTER_API_KEY=
PREFILTER_MODEL=~typesafe/jev-latest
# отсев при вероятности «вне стека» >= порога (0..1)
PREFILTER_THRESHOLD=0.8

# Parser Configuration
# активные парсеры через запятую: kwork, freelance_ru, freelancer
ENABLED_PARSERS=kwork,freelance_ru
# категория Kwork: 41 — Разработка и IT; 0 — без фильтра
KWORK_CATEGORY_ID=41
# категории ленты Freelance.ru: 4 — Веб-разработка и IT, 724 — ИИ и Нейросети
FREELANCE_RU_CATEGORIES=4,724
# id навыков Freelancer.com: Python, JavaScript, Node.js, Go, TypeScript, React
FREELANCER_SKILL_IDS=13,9,759,1093,1612,305
PARSER_TIMEOUT=30
CACHE_DAYS=30
# 0 — без ограничения
MAX_JOBS_PER_RUN=0
SEEN_FILE=.cache/seen_jobs.json

# Часовой пояс для дат в Issues: UTC+4, +04:00 или Europe/Samara
TIMEZONE=UTC+4

# Logging
LOG_LEVEL=INFO
# false — в логах только ID заказов, без названий
LOG_JOB_TITLES=true
